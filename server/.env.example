NODE_ENV=development
PORT=3000
PROMOTION_PUBLIC_BASE_URL=http://localhost:3000
APP_VERSION=0.1.0
LOG_LEVEL=info
ENABLE_DEMO_SANDBOX=true
DEMO_SMS_CODE=246810
ADMIN_PASSWORD=CHANGE_THIS_LOCAL_ADMIN_PASSWORD
PII_ENCRYPTION_KEY_HEX=GENERATE_32_BYTE_HEX_KEY
PHONE_HASH_KEY_HEX=GENERATE_A_DIFFERENT_32_BYTE_HEX_KEY
PAYMENT_SANDBOX_SECRET_HEX=GENERATE_ANOTHER_32_BYTE_HEX_KEY
INSURANCE_SANDBOX_SECRET_HEX=GENERATE_A_FOURTH_32_BYTE_HEX_KEY
UPLOAD_DIR=./.local-uploads

POSTGRES_DB=qingdao_fishing
POSTGRES_USER=fishing_app
POSTGRES_PASSWORD=CHANGE_THIS_LOCAL_PASSWORD
DATABASE_URL=postgres://fishing_app:CHANGE_THIS_LOCAL_PASSWORD@postgres:5432/qingdao_fishing
REDIS_URL=redis://redis:6379
